{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssumeAssignedWorkRoles",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": [
        "arn:aws:iam::774055931866:role/FDS-Network-Operator"
